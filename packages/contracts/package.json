{
  "name": "@rustauth/contracts",
  "version": "0.1.0",
  "description": "RustAuth HTTP contracts: TypeScript types generated from the Rust DTOs, plus Zod schemas.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/host39/lib-rustauth.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "ts"
  ],
  "exports": {
    ".": "./ts/index.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#generated/*": "./ts/generated/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
